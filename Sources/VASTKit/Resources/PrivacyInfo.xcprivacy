<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What this SDK does with data, as of this version.

  It collects nothing of its own. Every URI it requests came out of the VAST
  response the host's own ad server returned, and the SDK adds no identifier to
  it: §6 macros that would carry one — IFA, IFATYPE, LIMITADTRACKING — are not
  implemented, and each reports "unknown" instead.

  That is what makes NSPrivacyTracking false here, and it is the line to watch:
  the moment an identifier is supplied, this file has to say so — NSPrivacyTracking
  true, and the ad server's hosts listed under NSPrivacyTrackingDomains.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
</dict>
</plist>
